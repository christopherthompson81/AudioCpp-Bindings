<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AudioCpp.Demo"
        x:Class="AudioCpp.Demo.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="audio.cpp — C ABI demo" Width="1120" Height="760">

  <DockPanel Margin="12">

    <Border DockPanel.Dock="Bottom" Padding="8,6" Margin="0,10,0,0"
            Background="#1e1e24" CornerRadius="4">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding AbiVersion}" Opacity="0.6" FontSize="11" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <!-- Left: what to load and how to run it -->
    <Border DockPanel.Dock="Left" Width="340" Padding="0,0,12,0">
      <ScrollViewer>
        <StackPanel Spacing="8">

          <TextBlock Text="Model" FontWeight="SemiBold" />
          <TextBox Text="{Binding ModelPath}" PlaceholderText="path to a .gguf or model directory" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="File…" Click="OnPickModelFile" />
            <Button Content="Folder…" Click="OnPickModelFolder" />
            <Button Content="Load" Command="{Binding LoadCommand}" />
          </StackPanel>
          <TextBox Text="{Binding FamilyHint}" PlaceholderText="family hint (optional, e.g. kokoro_tts)" />

          <Separator Margin="0,6" />

          <TextBlock Text="Session" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
            <ComboBox Grid.Column="0" ItemsSource="{Binding Tasks}"
                      SelectedItem="{Binding Task}" HorizontalAlignment="Stretch" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding Backends}"
                      SelectedItem="{Binding Backend}" HorizontalAlignment="Stretch" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="threads" VerticalAlignment="Center" Opacity="0.7" />
            <NumericUpDown Value="{Binding Threads}" Minimum="1" Maximum="128"
                           Increment="1" FormatString="0" Width="110" />
          </StackPanel>

          <Separator Margin="0,6" />

          <TextBlock Text="Input" FontWeight="SemiBold" />
          <TextBox Text="{Binding Text}" AcceptsReturn="True" Height="80"
                   TextWrapping="Wrap" PlaceholderText="text to synthesise (tts)" />
          <TextBox Text="{Binding VoiceId}" PlaceholderText="voice id (optional, e.g. af_heart)" />
          <TextBox Text="{Binding AudioPath}" PlaceholderText="input WAV (asr / vad / diar / sep)" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Audio…" Click="OnPickAudio" />
            <Button Content="Run" Command="{Binding RunCommand}" FontWeight="SemiBold" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Right: what the model says about itself, and what a run produced -->
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

      <Border Grid.Row="0" Background="#1e1e24" CornerRadius="4" Padding="10" MinHeight="90">
        <TextBlock Text="{Binding ModelSummary}" FontFamily="monospace" FontSize="12"
                   TextWrapping="Wrap" />
      </Border>

      <TextBlock Grid.Row="1" Margin="0,12,0,4" FontWeight="SemiBold"
                 Text="Declared options — read from the model at runtime, not hardcoded" />

      <TabControl Grid.Row="2">
        <TabItem Header="Options">
          <DataGrid ItemsSource="{Binding Options}" IsReadOnly="True" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Scope"    Binding="{Binding Scope}"    Width="90" />
              <DataGridTextColumn Header="Name"     Binding="{Binding Name}"     Width="2*" />
              <DataGridTextColumn Header="Type"     Binding="{Binding Type}"     Width="*" />
              <DataGridTextColumn Header="Default"  Binding="{Binding Default}"  Width="*" />
              <DataGridTextColumn Header="Range"    Binding="{Binding Range}"    Width="90" />
              <DataGridCheckBoxColumn Header="Req"  Binding="{Binding Required}" Width="50" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Results">
          <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Kind"   Binding="{Binding Kind}"   Width="90" />
              <DataGridTextColumn Header="Span"   Binding="{Binding Span}"   Width="140" />
              <DataGridTextColumn Header="Value"  Binding="{Binding Value}"  Width="3*" />
              <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Transcript">
          <TextBox Text="{Binding Transcript}" IsReadOnly="True" AcceptsReturn="True"
                   TextWrapping="Wrap" FontSize="14" />
        </TabItem>
      </TabControl>

      <vm:WaveformView Grid.Row="3" Height="90" Margin="0,10,0,0"
                       Samples="{Binding OutputSamples}" />

      <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
        <Button Content="Save WAV…" Command="{Binding SaveWavCommand}" />
        <TextBlock Text="{Binding OutputSummary}" VerticalAlignment="Center" Opacity="0.7" />
        <TextBlock Text="{Binding Timing}" VerticalAlignment="Center" Opacity="0.7" />
      </StackPanel>

    </Grid>
  </DockPanel>
</Window>
