<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>AudioCpp.Bindings.Gui</AssemblyName>
    <RootNamespace>AudioCpp.Bindings.Gui</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resources are embedded by convention; satellite assemblies are produced
         for every Strings.<culture>.resx alongside. The it/pl/ru/zh files are
         generated by tools/locales/import_webui_locales.py from the audio.cpp
         web UI's catalogue — see NOTICE. -->
    <EmbeddedResource Update="Resources/Strings.resx">
      <LogicalName>AudioCpp.Bindings.Gui.Resources.Strings.resources</LogicalName>
    </EmbeddedResource>
    <!-- The pseudo-locale is a development aid. Keeping it out of Release stops
         a satellite assembly of accented English shipping to users. -->
    <EmbeddedResource Remove="Resources/Strings.qps-ploc.resx" Condition="'$(Configuration)' == 'Release'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AudioCpp/AudioCpp.csproj" />
    <ProjectReference Include="../AudioCpp.Audio/AudioCpp.Audio.csproj" />
    <ProjectReference Include="../AudioCpp.Packages/AudioCpp.Packages.csproj" />
  </ItemGroup>

</Project>
