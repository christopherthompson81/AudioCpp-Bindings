<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AudioCpp.Bindings.Gui"
        x:Class="AudioCpp.Bindings.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="audio.cpp — native studio" Width="1400" Height="940"
        Background="{DynamicResource AppBg}">

  <DockPanel>

    <!-- Top bar: identity on the left, global settings on the right. -->
    <Border DockPanel.Dock="Top" Classes="Bar" Padding="20,12">
      <Grid ColumnDefinitions="Auto,24,Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <Border Width="34" Height="34" CornerRadius="9"
                  Background="{DynamicResource AppAccent}">
            <TextBlock Text="A" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource AppTextInvert}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="audio.cpp" Classes="Title" FontSize="15" />
            <TextBlock Text="NATIVE STUDIO" Classes="Eyebrow" />
          </StackPanel>
        </StackPanel>

        <!-- Horizontal explicitly: the Chips class panels with a WrapPanel for
             the task row, which stacks these two and doubles the bar's height. -->
        <ListBox Grid.Column="2" Classes="Chips" ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding Page}" Background="Transparent"
                 BorderThickness="0" Padding="0" VerticalAlignment="Center">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>

        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="14"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding AbiVersion}" Classes="Subtle" VerticalAlignment="Center" />
          <Border Background="{DynamicResource AppChip}" BorderBrush="{DynamicResource AppLine}"
                  BorderThickness="1" CornerRadius="20" Padding="12,5">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                       Fill="{DynamicResource AppAccent}" />
              <TextBlock Text="{Binding BackendBadge}" Classes="Eyebrow" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status strip, kept at the bottom where it was. -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppPanel}"
            BorderBrush="{DynamicResource AppLine}" BorderThickness="0,1,0,0"
            Padding="20,10">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Timing}" Classes="Subtle" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <ScrollViewer Padding="20,16" IsVisible="{Binding IsArena}">
      <StackPanel Spacing="16" DataContext="{Binding Arena}">
        <StackPanel Spacing="4">
          <TextBlock Text="COMPARE" Classes="Eyebrow" Foreground="{DynamicResource AppAccent}" />
          <TextBlock Text="Arena" Classes="Hero" />
          <TextBlock Classes="Subtle" FontSize="13"
                     Text="Two configurations, one input. Which quantisation, backend or family is good enough to use." />
        </StackPanel>

        <Grid ColumnDefinitions="*,16,*">
          <Border Grid.Column="0" Classes="Card" VerticalAlignment="Top">
            <StackPanel Spacing="9" DataContext="{Binding Left}">
              <TextBlock Text="SIDE A" Classes="Eyebrow" />
              <TextBox Text="{Binding ModelPath}" PlaceholderText="path to a .gguf or directory" />
              <TextBox Text="{Binding FamilyHint}" PlaceholderText="family hint (optional)" />
              <Grid ColumnDefinitions="*,8,*">
                <ComboBox Grid.Column="0" ItemsSource="{Binding Backends}"
                          SelectedItem="{Binding Backend}" HorizontalAlignment="Stretch" />
                <NumericUpDown Grid.Column="2" Value="{Binding Threads}" Minimum="1" Maximum="128"
                               Increment="1" FormatString="0" />
              </Grid>
              <TextBlock Text="{Binding Status}" Classes="Subtle" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Timing}" Classes="Subtle" FontSize="11" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Unload"
                        Command="{Binding $parent[ScrollViewer].((vm:Arena)DataContext).UnloadLeftCommand}" />
                <Button Content="Play"
                        Command="{Binding $parent[ScrollViewer].((vm:Arena)DataContext).PlayLeftCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Classes="Card" VerticalAlignment="Top">
            <StackPanel Spacing="9" DataContext="{Binding Right}">
              <TextBlock Text="SIDE B" Classes="Eyebrow" />
              <TextBox Text="{Binding ModelPath}" PlaceholderText="path to a .gguf or directory" />
              <TextBox Text="{Binding FamilyHint}" PlaceholderText="family hint (optional)" />
              <Grid ColumnDefinitions="*,8,*">
                <ComboBox Grid.Column="0" ItemsSource="{Binding Backends}"
                          SelectedItem="{Binding Backend}" HorizontalAlignment="Stretch" />
                <NumericUpDown Grid.Column="2" Value="{Binding Threads}" Minimum="1" Maximum="128"
                               Increment="1" FormatString="0" />
              </Grid>
              <TextBlock Text="{Binding Status}" Classes="Subtle" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Timing}" Classes="Subtle" FontSize="11" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Unload"
                        Command="{Binding $parent[ScrollViewer].((vm:Arena)DataContext).UnloadRightCommand}" />
                <Button Content="Play"
                        Command="{Binding $parent[ScrollViewer].((vm:Arena)DataContext).PlayRightCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Text="INPUT" Classes="Eyebrow" />
            <Grid ColumnDefinitions="Auto,10,*">
              <ComboBox Grid.Column="0" ItemsSource="{Binding Tasks}" SelectedItem="{Binding Task}" />
              <TextBox Grid.Column="2" Text="{Binding AudioPath}" PlaceholderText="input WAV" />
            </Grid>
            <TextBox Text="{Binding Text}" PlaceholderText="text, for tts" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Load A" Command="{Binding LoadLeftCommand}" />
              <Button Content="Load B" Command="{Binding LoadRightCommand}" />
              <Button Classes="Primary" Content="Compare" Command="{Binding CompareCommand}" />
              <TextBlock Text="{Binding Status}" Classes="Subtle" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Text="RESULT" Classes="Eyebrow" />
            <TextBlock Text="{Binding Summary}" Classes="Title" FontSize="15" />
            <TextBlock Classes="Subtle" FontSize="11"
                       Text="Grey where both agree, orange for A only, blue for B only." />
            <ScrollViewer Height="260">
              <ItemsControl ItemsSource="{Binding Diff}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DiffPiece">
                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"
                               Margin="0,0,5,2" ToolTip.Tip="{Binding Side}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Padding="20,16" IsVisible="{Binding IsStudio}">
      <StackPanel Spacing="16">

        <!-- Task chips. The engine decides what a family supports; these mirror
             the tasks the ABI exposes rather than the web UI's curated groups. -->
        <ListBox Classes="Chips" ItemsSource="{Binding TaskChips}"
                 SelectedItem="{Binding SelectedChip}"
                 Background="Transparent" BorderThickness="0" Padding="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TaskChip">
              <Grid ColumnDefinitions="Auto,16,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="Subtle"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Hero -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="LOCAL AUDIO INTELLIGENCE" Classes="Eyebrow"
                       Foreground="{DynamicResource AppAccent}" />
            <TextBlock Text="{Binding TaskTitle}" Classes="Hero" />
            <TextBlock Text="{Binding TaskBlurb}" Classes="Subtle" FontSize="13" />
          </StackPanel>

          <Border Grid.Column="1" Classes="Card" Padding="18,14" MinWidth="300"
                  VerticalAlignment="Top">
            <StackPanel Spacing="3">
              <TextBlock Text="MODEL" Classes="Eyebrow" />
              <TextBlock Text="{Binding LoadedModelName}" Classes="Title" FontSize="15" />
              <TextBlock Text="{Binding LoadedModelState}" Classes="Eyebrow"
                         Foreground="{DynamicResource AppAccent}" />
              <!-- On disk, not in memory: the ABI reports no runtime footprint. -->
              <TextBlock Text="{Binding LoadedModelWeights}" Classes="Subtle" FontSize="11" />
              <Button Content="Unload" Command="{Binding UnloadCommand}"
                      HorizontalAlignment="Left" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Three columns: what to load, what to send, what came back. -->
        <Grid ColumnDefinitions="330,16,*,16,1.1*">

          <Border Grid.Column="0" Classes="Card" VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <TextBlock Text="MODEL" Classes="Eyebrow" />

              <!-- The package picker the reference UI leads with. Falls back to
                   the path box below, which still takes anything on disk. -->
              <ComboBox ItemsSource="{Binding CatalogEntries}"
                        SelectedItem="{Binding SelectedEntry}"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="choose a package…">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CatalogEntry">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" />
                      <TextBlock Text="{Binding Subtitle}" Classes="Subtle" FontSize="11" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Border Background="{DynamicResource AppChip}"
                      BorderBrush="{DynamicResource AppLine}" BorderThickness="1"
                      CornerRadius="8" Padding="12,9">
                <StackPanel Spacing="7">
                  <TextBlock Text="{Binding SelectedSummary}" Classes="Subtle"
                             TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Install" Command="{Binding InstallCommand}" />
                    <Button Content="Delete" Command="{Binding DeleteCommand}" />
                  </StackPanel>
                  <ProgressBar Value="{Binding InstallFraction}" Minimum="0" Maximum="1"
                               Height="4" IsVisible="{Binding Busy}" />
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding InstallStatus}" Classes="Subtle" TextWrapping="Wrap"
                         FontSize="11" />
              <TextBox Text="{Binding ModelsRoot}" PlaceholderText="models root" />

              <Border Height="1" Background="{DynamicResource AppLine}" Margin="0,4" />

              <TextBox Text="{Binding ModelPath}"
                       PlaceholderText="path to a .gguf or model directory" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="File…" Click="OnPickModelFile" />
                <Button Content="Folder…" Click="OnPickModelFolder" />
                <Button Content="Load" Command="{Binding LoadCommand}" />
              </StackPanel>
              <TextBox Text="{Binding FamilyHint}" PlaceholderText="family hint (optional)" />

              <Border Height="1" Background="{DynamicResource AppLine}" Margin="0,4" />

              <TextBlock Text="SESSION" Classes="Eyebrow" />
              <Grid ColumnDefinitions="*,8,*">
                <ComboBox Grid.Column="0" ItemsSource="{Binding Backends}"
                          SelectedItem="{Binding Backend}" HorizontalAlignment="Stretch" />
                <NumericUpDown Grid.Column="2" Value="{Binding Threads}" Minimum="1"
                               Maximum="128" Increment="1" FormatString="0" />
              </Grid>

              <Border Height="1" Background="{DynamicResource AppLine}" Margin="0,4" />

              <StackPanel Spacing="10" IsVisible="{Binding ShowAsrAudioControls}">
              <TextBlock Text="LONG AUDIO" Classes="Eyebrow" />
              <CheckBox IsChecked="{Binding UseBuiltInChunking}"
                        IsEnabled="{Binding !HasVadModel}"
                        Content="Built-in chunking (clips over 5 min)" />
              <StackPanel Orientation="Horizontal" Spacing="8"
                          IsEnabled="{Binding ChunkingApplies}">
                <TextBlock Text="chunk s" Classes="Subtle" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding ChunkSeconds}" Minimum="1" Maximum="60"
                               Increment="1" FormatString="0" Width="110" />
              </StackPanel>
              <TextBox Text="{Binding VadAssetPath}" IsEnabled="{Binding ChunkingApplies}"
                       PlaceholderText="silero_vad dir (blank = search)" />

              <TextBox Text="{Binding VadModelPath}"
                       PlaceholderText="VAD model — this app segments instead" />
              <Button Content="VAD…" Click="OnPickVadModel" HorizontalAlignment="Left" />
              <Grid ColumnDefinitions="Auto,8,*,8,*" IsVisible="{Binding HasVadModel}">
                <TextBlock Grid.Column="0" Text="group (s)" Classes="Subtle"
                           VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="2" Value="{Binding MinSegmentSpan}" Minimum="1"
                               Maximum="60" Increment="1" FormatString="0" MinWidth="100" />
                <NumericUpDown Grid.Column="4" Value="{Binding MaxSegmentSpan}" Minimum="2"
                               Maximum="120" Increment="1" FormatString="0" MinWidth="100" />
              </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Classes="Card" VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="REQUEST" Classes="Eyebrow" />
                  <TextBlock Text="Input &amp; controls" Classes="Title" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource AppChip}"
                        BorderBrush="{DynamicResource AppLine}" BorderThickness="1"
                        CornerRadius="14" Padding="10,4" VerticalAlignment="Top">
                  <TextBlock Text="{Binding TaskBadge}" Classes="Eyebrow" />
                </Border>
              </Grid>

              <StackPanel Spacing="10" IsVisible="{Binding ShowText}">
                <TextBlock Text="Text" Classes="Label" />
                <TextBox Text="{Binding Text}" AcceptsReturn="True" Height="110"
                         TextWrapping="Wrap" PlaceholderText="Enter the text…" />
              </StackPanel>

              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowTextChunking}">
                <CheckBox Grid.Column="0" IsChecked="{Binding SplitLongText}"
                          Content="Split and merge long text" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            IsEnabled="{Binding SplitLongText}">
                  <TextBlock Text="chars per chunk" Classes="Subtle" VerticalAlignment="Center" />
                  <NumericUpDown Value="{Binding ChunkBudget}" Minimum="1" Maximum="20000"
                                 Increment="100" FormatString="0" Width="130" />
                </StackPanel>
              </Grid>

              <StackPanel Spacing="10" IsVisible="{Binding ShowVoice}">
                <TextBlock Text="Voice id" Classes="Label" />
                <TextBox Text="{Binding VoiceId}" PlaceholderText="optional, e.g. af_heart" />
              </StackPanel>

              <StackPanel Spacing="10" IsVisible="{Binding ShowAudioInput}">
                <Border Height="1" Background="{DynamicResource AppLine}" Margin="0,2" />
                <TextBlock Text="Audio input" Classes="Label" />
                <TextBox Text="{Binding AudioPath}"
                         PlaceholderText="input WAV" />
                <Button Content="Audio…" Click="OnPickAudio" HorizontalAlignment="Left" />
              </StackPanel>

              <StackPanel Spacing="10" IsVisible="{Binding ShowAsrAudioControls}">
              <Border Height="1" Background="{DynamicResource AppLine}" Margin="0,2" />

              <TextBlock Text="Microphone" Classes="Label" />
              <Grid ColumnDefinitions="*,8,Auto">
                <ComboBox Grid.Column="0" ItemsSource="{Binding CaptureDevices}"
                          SelectedItem="{Binding CaptureDevice}"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="system default input" />
                <Button Grid.Column="2" Classes="Primary" Content="{Binding RecordLabel}"
                        Command="{Binding RecordCommand}" MinWidth="92" />
              </Grid>
              <!-- A meter is how a user knows the mic is live before they discover
                   the transcript is empty. -->
              <ProgressBar Value="{Binding InputLevel}" Minimum="0" Maximum="1" Height="4" />
              <TextBlock Text="{Binding LiveStatus}" Classes="Subtle" FontSize="11"
                         TextWrapping="Wrap" />
              </StackPanel>

              <Border Height="1" Background="{DynamicResource AppLine}" Margin="0,2" />

              <TextBlock Text="Options the model declares about itself. Blank means the model's own default."
                         Classes="Subtle" TextWrapping="Wrap" />

              <!-- Typed editors built from what the model reports: pipe-separated
                   types become dropdowns, bool becomes a checkbox, bounded
                   numerics a slider, the rest a spinner or a text box. -->
              <ItemsControl ItemsSource="{Binding RequestOptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DeclaredOption">
                    <Grid ColumnDefinitions="230,10,*" Margin="0,0,0,7"
                          ToolTip.Tip="{Binding Description}">
                      <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="Subtle"
                                 TextWrapping="Wrap" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="2" IsVisible="{Binding IsChoice}"
                                ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}"
                                HorizontalAlignment="Stretch" />
                      <CheckBox Grid.Column="2" IsVisible="{Binding IsToggle}"
                                IsChecked="{Binding Toggle}" />
                      <Slider Grid.Column="2" IsVisible="{Binding IsSlider}"
                              Minimum="{Binding NumberMin}" Maximum="{Binding NumberMax}"
                              Value="{Binding NumberValue}" />
                      <NumericUpDown Grid.Column="2" IsVisible="{Binding IsNumber}"
                                     Value="{Binding NumberValue}" Increment="{Binding NumberStep}"
                                     Minimum="{Binding NumberMin}" Maximum="{Binding NumberMax}"
                                     HorizontalAlignment="Stretch" />
                      <TextBox Grid.Column="2" IsVisible="{Binding IsText}"
                               Text="{Binding Value}" Watermark="{Binding DefaultDisplay}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Session options are shown apart because changing one rebuilds
                   the session: a different promise from a per-run setting. -->
              <Expander Header="Session options — changing one rebuilds the session">
                <ItemsControl ItemsSource="{Binding SessionOptions}" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeclaredOption">
                      <Grid ColumnDefinitions="230,10,*" Margin="0,0,0,7"
                            ToolTip.Tip="{Binding Description}">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="Subtle"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="2" IsVisible="{Binding IsChoice}"
                                  ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}"
                                  HorizontalAlignment="Stretch" />
                        <CheckBox Grid.Column="2" IsVisible="{Binding IsToggle}"
                                  IsChecked="{Binding Toggle}" />
                        <Slider Grid.Column="2" IsVisible="{Binding IsSlider}"
                                Minimum="{Binding NumberMin}" Maximum="{Binding NumberMax}"
                                Value="{Binding NumberValue}" />
                        <NumericUpDown Grid.Column="2" IsVisible="{Binding IsNumber}"
                                       Value="{Binding NumberValue}" Increment="{Binding NumberStep}"
                                       Minimum="{Binding NumberMin}" Maximum="{Binding NumberMax}"
                                       HorizontalAlignment="Stretch" />
                        <TextBox Grid.Column="2" IsVisible="{Binding IsText}"
                                 Text="{Binding Value}" Watermark="{Binding DefaultDisplay}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>

              <!-- The full surface stays reachable: nothing hardcoded means
                   nothing hidden either. -->
              <Expander Header="All declared options" IsExpanded="{Binding ShowAllOptions}">
                <DataGrid ItemsSource="{Binding Options}" Height="200"
                          GridLinesVisibility="Horizontal"
                          HorizontalScrollBarVisibility="Auto">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Scope"   Binding="{Binding Scope}" Width="90"  IsReadOnly="True" />
                    <DataGridTextColumn Header="Name"    Binding="{Binding Name}"  Width="200" IsReadOnly="True" />
                    <DataGridTextColumn Header="Type"    Binding="{Binding Type}"  Width="110" IsReadOnly="True" />
                    <DataGridTextColumn Header="Default" Binding="{Binding Default}" Width="90" IsReadOnly="True" />
                    <DataGridTextColumn Header="Value"   Binding="{Binding Value}" Width="*" MinWidth="120" />
                  </DataGrid.Columns>
                </DataGrid>
              </Expander>

              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="Primary" Content="Run" Command="{Binding RunCommand}" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" />
                <TextBlock Text="{Binding RunState}" Classes="Subtle"
                           VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="4" Classes="Card" VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <TextBlock Text="RESULT" Classes="Eyebrow" />
              <TextBlock Text="Output" Classes="Title" />

              <TabControl>
                <TabItem Header="Transcript">
                  <TextBox Text="{Binding Transcript}" IsReadOnly="True" AcceptsReturn="True"
                           TextWrapping="Wrap" Height="300" FontSize="13" />
                </TabItem>
                <TabItem Header="Rows">
                  <!-- Selecting a row seeks the preview to it. -->
                  <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" Height="300"
                            SelectedItem="{Binding SelectedRow}"
                            GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Kind"   Binding="{Binding Kind}"   Width="80" />
                      <DataGridTextColumn Header="Span"   Binding="{Binding Span}"   Width="130" />
                      <DataGridTextColumn Header="Value"  Binding="{Binding Value}"  Width="3*" />
                      <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                </TabItem>
                <TabItem Header="Streams" IsVisible="{Binding OutputStreams.Count}">
                  <!-- Separation returns one buffer per stem; a single waveform
                       would hide all but the first. -->
                  <ItemsControl ItemsSource="{Binding OutputStreams}" Height="300">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:NamedAudioEntry">
                        <Border Classes="Card" Padding="12" Margin="0,0,0,8">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                              <TextBlock Text="{Binding Id}" Classes="Label" />
                              <TextBlock Text="{Binding Summary}" Classes="Subtle" FontSize="11" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Save…"
                                    Click="OnSaveStream" Tag="{Binding}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </TabItem>
                <TabItem Header="Artifacts" IsVisible="{Binding Artifacts.Count}">
                  <ItemsControl ItemsSource="{Binding Artifacts}" Height="300">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ArtifactEntry">
                        <Border Classes="Card" Padding="12" Margin="0,0,0,8">
                          <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Id}" Classes="Label" />
                            <TextBlock Text="{Binding Summary}" Classes="Subtle" FontSize="11" />
                            <TextBox Text="{Binding Preview}" IsReadOnly="True" MaxHeight="150"
                                     AcceptsReturn="True" TextWrapping="Wrap" FontSize="11" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </TabItem>
                <TabItem Header="JSON">
                  <TextBox Text="{Binding ResultJson}" IsReadOnly="True" AcceptsReturn="True"
                           TextWrapping="NoWrap" Height="300" FontSize="12"
                           FontFamily="monospace" />
                </TabItem>
                <TabItem Header="Model">
                  <TextBox Text="{Binding ModelSummary}" IsReadOnly="True" AcceptsReturn="True"
                           TextWrapping="Wrap" Height="300" FontSize="12"
                           FontFamily="monospace" />
                </TabItem>
              </TabControl>

              <!-- Click or drag the waveform to seek; the cursor follows playback. -->
              <vm:WaveformView Height="90" Samples="{Binding OutputSamples}"
                               Progress="{Binding PlayProgress}"
                               Seek="{Binding SeekTo}" />
              <TextBlock Text="{Binding TimingBreakdown}" Classes="Subtle" FontSize="11" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding PlayLabel}" Command="{Binding PlayCommand}" MinWidth="76" />
                <Button Content="Save WAV…" Command="{Binding SaveWavCommand}" />
                <!-- A transcript with word timings is a subtitle track that has
                     not been cut into lines yet. -->
                <Button Content="SRT…" Command="{Binding SaveSrtCommand}" />
                <Button Content="VTT…" Command="{Binding SaveVttCommand}" />
                <TextBlock Text="{Binding PlayStatus}" Classes="Subtle" VerticalAlignment="Center" />
                <TextBlock Text="{Binding OutputSummary}" Classes="Subtle"
                           VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>

        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
