<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AudioCpp.Bindings.Gui"
        x:Class="AudioCpp.Bindings.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="audio.cpp — native studio" Width="1400" Height="940"
        Background="{DynamicResource AppBg}">

  <DockPanel>

    <!-- Top bar: identity on the left, global settings on the right. -->
    <Border DockPanel.Dock="Top" Classes="Bar" Padding="20,12">
      <Grid ColumnDefinitions="Auto,24,Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <Border Width="34" Height="34" CornerRadius="9"
                  Background="{DynamicResource AppAccent}">
            <TextBlock Text="A" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource AppTextInvert}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="audio.cpp" Classes="Title" FontSize="15" />
            <TextBlock Text="NATIVE STUDIO" Classes="Eyebrow" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center">
          <TextBlock Text="Studio" Classes="Label" Margin="12,0"
                     Foreground="{DynamicResource AppTextStrong}" />
        </StackPanel>

        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="14"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding AbiVersion}" Classes="Subtle" VerticalAlignment="Center" />
          <Border Background="{DynamicResource AppChip}" BorderBrush="{DynamicResource AppLine}"
                  BorderThickness="1" CornerRadius="20" Padding="12,5">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                       Fill="{DynamicResource AppAccent}" />
              <TextBlock Text="{Binding BackendBadge}" Classes="Eyebrow" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status strip, kept at the bottom where it was. -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppPanel}"
            BorderBrush="{DynamicResource AppLine}" BorderThickness="0,1,0,0"
            Padding="20,10">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Timing}" Classes="Subtle" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <ScrollViewer Padding="20,16">
      <StackPanel Spacing="16">

        <!-- Task chips. The engine decides what a family supports; these mirror
             the tasks the ABI exposes rather than the web UI's curated groups. -->
        <ListBox Classes="Chips" ItemsSource="{Binding TaskChips}"
                 SelectedItem="{Binding SelectedChip}"
                 Background="Transparent" BorderThickness="0" Padding="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TaskChip">
              <Grid ColumnDefinitions="Auto,16,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="Subtle"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Hero -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="LOCAL AUDIO INTELLIGENCE" Classes="Eyebrow"
                       Foreground="{DynamicResource AppAccent}" />
            <TextBlock Text="{Binding TaskTitle}" Classes="Hero" />
            <TextBlock Text="{Binding TaskBlurb}" Classes="Subtle" FontSize="13" />
          </StackPanel>

          <Border Grid.Column="1" Classes="Card" Padding="18,14" MinWidth="300"
                  VerticalAlignment="Top">
            <StackPanel Spacing="3">
              <TextBlock Text="MODEL" Classes="Eyebrow" />
              <TextBlock Text="{Binding LoadedModelName}" Classes="Title" FontSize="15" />
              <TextBlock Text="{Binding LoadedModelState}" Classes="Eyebrow"
                         Foreground="{DynamicResource AppAccent}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Three columns: what to load, what to send, what came back. -->
        <Grid ColumnDefinitions="330,16,*,16,1.1*">

          <Border Grid.Column="0" Classes="Card" VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <TextBlock Text="MODEL" Classes="Eyebrow" />

              <!-- The package picker the reference UI leads with. Falls back to
                   the path box below, which still takes anything on disk. -->
              <ComboBox ItemsSource="{Binding CatalogEntries}"
                        SelectedItem="{Binding SelectedEntry}"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="choose a package…">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CatalogEntry">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" />
                      <TextBlock Text="{Binding Subtitle}" Classes="Subtle" FontSize="11" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Border Background="{DynamicResource AppChip}"
                      BorderBrush="{DynamicResource AppLine}" BorderThickness="1"
                      CornerRadius="8" Padding="12,9">
                <StackPanel Spacing="7">
                  <TextBlock Text="{Binding SelectedSummary}" Classes="Subtle"
                             TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Install" Command="{Binding InstallCommand}" />
                    <Button Content="Delete" Command="{Binding DeleteCommand}" />
                  </StackPanel>
                  <ProgressBar Value="{Binding InstallFraction}" Minimum="0" Maximum="1"
                               Height="4" IsVisible="{Binding Busy}" />
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding InstallStatus}" Classes="Subtle" TextWrapping="Wrap"
                         FontSize="11" />
              <TextBox Text="{Binding ModelsRoot}" PlaceholderText="models root" />

              <Border Height="1" Background="{DynamicResource AppLine}" Margin="0,4" />

              <TextBox Text="{Binding ModelPath}"
                       PlaceholderText="path to a .gguf or model directory" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="File…" Click="OnPickModelFile" />
                <Button Content="Folder…" Click="OnPickModelFolder" />
                <Button Content="Load" Command="{Binding LoadCommand}" />
              </StackPanel>
              <TextBox Text="{Binding FamilyHint}" PlaceholderText="family hint (optional)" />

              <Border Height="1" Background="{DynamicResource AppLine}" Margin="0,4" />

              <TextBlock Text="SESSION" Classes="Eyebrow" />
              <Grid ColumnDefinitions="*,8,*">
                <ComboBox Grid.Column="0" ItemsSource="{Binding Backends}"
                          SelectedItem="{Binding Backend}" HorizontalAlignment="Stretch" />
                <NumericUpDown Grid.Column="2" Value="{Binding Threads}" Minimum="1"
                               Maximum="128" Increment="1" FormatString="0" />
              </Grid>

              <Border Height="1" Background="{DynamicResource AppLine}" Margin="0,4" />

              <TextBlock Text="LONG AUDIO" Classes="Eyebrow" />
              <CheckBox IsChecked="{Binding UseBuiltInChunking}"
                        IsEnabled="{Binding !HasVadModel}"
                        Content="Built-in chunking (clips over 5 min)" />
              <StackPanel Orientation="Horizontal" Spacing="8"
                          IsEnabled="{Binding ChunkingApplies}">
                <TextBlock Text="chunk s" Classes="Subtle" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding ChunkSeconds}" Minimum="1" Maximum="60"
                               Increment="1" FormatString="0" Width="110" />
              </StackPanel>
              <TextBox Text="{Binding VadAssetPath}" IsEnabled="{Binding ChunkingApplies}"
                       PlaceholderText="silero_vad dir (blank = search)" />

              <TextBox Text="{Binding VadModelPath}"
                       PlaceholderText="VAD model — this app segments instead" />
              <Button Content="VAD…" Click="OnPickVadModel" HorizontalAlignment="Left" />
              <Grid ColumnDefinitions="Auto,8,*,8,*" IsVisible="{Binding HasVadModel}">
                <TextBlock Grid.Column="0" Text="group (s)" Classes="Subtle"
                           VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="2" Value="{Binding MinSegmentSpan}" Minimum="1"
                               Maximum="60" Increment="1" FormatString="0" MinWidth="100" />
                <NumericUpDown Grid.Column="4" Value="{Binding MaxSegmentSpan}" Minimum="2"
                               Maximum="120" Increment="1" FormatString="0" MinWidth="100" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Classes="Card" VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="REQUEST" Classes="Eyebrow" />
                  <TextBlock Text="Input &amp; controls" Classes="Title" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource AppChip}"
                        BorderBrush="{DynamicResource AppLine}" BorderThickness="1"
                        CornerRadius="14" Padding="10,4" VerticalAlignment="Top">
                  <TextBlock Text="{Binding TaskBadge}" Classes="Eyebrow" />
                </Border>
              </Grid>

              <TextBlock Text="Text" Classes="Label" />
              <TextBox Text="{Binding Text}" AcceptsReturn="True" Height="110"
                       TextWrapping="Wrap" PlaceholderText="Enter the text…" />

              <TextBlock Text="Voice id" Classes="Label" />
              <TextBox Text="{Binding VoiceId}" PlaceholderText="optional, e.g. af_heart" />

              <Border Height="1" Background="{DynamicResource AppLine}" Margin="0,2" />

              <TextBlock Text="Audio input" Classes="Label" />
              <TextBox Text="{Binding AudioPath}"
                       PlaceholderText="input WAV (asr / vad / diar / sep)" />
              <Button Content="Audio…" Click="OnPickAudio" HorizontalAlignment="Left" />

              <Border Height="1" Background="{DynamicResource AppLine}" Margin="0,2" />

              <TextBlock Text="Declared options — read from the model at runtime. Edit Value to set one; blank uses the model's default."
                         Classes="Subtle" TextWrapping="Wrap" />
              <DataGrid ItemsSource="{Binding Options}" Height="160"
                        GridLinesVisibility="Horizontal"
                        HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Scope"   Binding="{Binding Scope}" Width="90"  IsReadOnly="True" />
                  <DataGridTextColumn Header="Name"    Binding="{Binding Name}"  Width="200" IsReadOnly="True" />
                  <DataGridTextColumn Header="Type"    Binding="{Binding Type}"  Width="110" IsReadOnly="True" />
                  <DataGridTextColumn Header="Default" Binding="{Binding Default}" Width="90" IsReadOnly="True" />
                  <DataGridTextColumn Header="Value"   Binding="{Binding Value}" Width="*" MinWidth="120" />
                </DataGrid.Columns>
              </DataGrid>

              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="Primary" Content="Run" Command="{Binding RunCommand}" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" />
                <TextBlock Text="{Binding RunState}" Classes="Subtle"
                           VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="4" Classes="Card" VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <TextBlock Text="RESULT" Classes="Eyebrow" />
              <TextBlock Text="Output" Classes="Title" />

              <TabControl>
                <TabItem Header="Transcript">
                  <TextBox Text="{Binding Transcript}" IsReadOnly="True" AcceptsReturn="True"
                           TextWrapping="Wrap" Height="300" FontSize="13" />
                </TabItem>
                <TabItem Header="Rows">
                  <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" Height="300"
                            GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Kind"   Binding="{Binding Kind}"   Width="80" />
                      <DataGridTextColumn Header="Span"   Binding="{Binding Span}"   Width="130" />
                      <DataGridTextColumn Header="Value"  Binding="{Binding Value}"  Width="3*" />
                      <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                </TabItem>
                <TabItem Header="JSON">
                  <TextBox Text="{Binding ResultJson}" IsReadOnly="True" AcceptsReturn="True"
                           TextWrapping="NoWrap" Height="300" FontSize="12"
                           FontFamily="monospace" />
                </TabItem>
                <TabItem Header="Model">
                  <TextBox Text="{Binding ModelSummary}" IsReadOnly="True" AcceptsReturn="True"
                           TextWrapping="Wrap" Height="300" FontSize="12"
                           FontFamily="monospace" />
                </TabItem>
              </TabControl>

              <vm:WaveformView Height="90" Samples="{Binding OutputSamples}" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Save WAV…" Command="{Binding SaveWavCommand}" />
                <TextBlock Text="{Binding OutputSummary}" Classes="Subtle"
                           VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>

        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
