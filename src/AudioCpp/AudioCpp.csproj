<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- This is an interop assembly: the native ABI hands back borrowed
         pointers, and wrapping them without copying needs pointer types. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
    <AssemblyName>AudioCpp</AssemblyName>
    <RootNamespace>AudioCpp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The coverage test reflects over NativeMethods to assert every ABI entry
         point is bound; reading the source text instead would only prove the file
         mentions a name, not that it compiled into a binding. -->
    <InternalsVisibleTo Include="AudioCpp.BindingCoverage" />
  </ItemGroup>

</Project>
